BASIS_SOCIAL_IMAGE=ghcr.io/example/basisvr-social-service:release-tag
DOMAIN=social.example.com
CORS_ALLOWED_ORIGINS=https://app.example.com
REGISTRATION_ENABLED=false
FEDERATION_MODE=allowlist
ACTIVITYPUB_ENABLED=true
ACTIVITYPUB_AUTHORIZED_FETCH=protected
OTEL_TRACING_ENABLED=false
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4318
OTEL_BACKEND_OTLP_ENDPOINT=https://telemetry-provider.example
OTEL_BACKEND_AUTHORIZATION=Bearer replace-with-provider-token
OTEL_TRACES_SAMPLER_RATIO=0.1
DATABASE_URL_SECRET_FILE=./secrets/database_url
REDIS_URL_SECRET_FILE=./secrets/redis_url
JWT_SECRET_FILE=./secrets/jwt_secret

# Persistent AES-256 actor-key wrapping secret, same file contents on every API/delivery node.
ACTOR_KEY_ENCRYPTION_KEY_FILE=./secrets/actor_key_encryption_key

# Optional BeeBa identity authority. Configure a separate shared service secret.
BEEBA_IDENTITY_ENABLED=false
BEEBA_IDENTITY_API_URL=
BEEBA_IDENTITY_PUBLIC_URL=
BEEBA_IDENTITY_SECRET=
# File-based bridge secrets require a Compose override that forwards BEEBA_IDENTITY_SECRET_FILE and mounts its file.
BEEBA_IDENTITY_TIMEOUT=3s

# Set only actual trusted reverse-proxy peer CIDRs; never use 0.0.0.0/0.
# Empty safely ignores forwarded headers but all proxied clients share the proxy IP rate limits.
TRUSTED_PROXY_CIDRS=
AUTH_RATE_LIMIT_REQUESTS=20
