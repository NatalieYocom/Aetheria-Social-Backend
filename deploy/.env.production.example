BASIS_SOCIAL_IMAGE=ghcr.io/example/basisvr-social-service:release-tag
DOMAIN=social.example.com
CORS_ALLOWED_ORIGINS=https://app.example.com
REGISTRATION_ENABLED=false
FEDERATION_MODE=allowlist
ACTIVITYPUB_ENABLED=true
ACTIVITYPUB_AUTHORIZED_FETCH=protected
OTEL_TRACING_ENABLED=false
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4318
OTEL_BACKEND_OTLP_ENDPOINT=https://telemetry-provider.example
OTEL_BACKEND_AUTHORIZATION=Bearer replace-with-provider-token
OTEL_TRACES_SAMPLER_RATIO=0.1
DATABASE_URL_SECRET_FILE=./secrets/database_url
REDIS_URL_SECRET_FILE=./secrets/redis_url
JWT_SECRET_FILE=./secrets/jwt_secret
