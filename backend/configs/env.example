APP_ENV=development
API_BIND=0.0.0.0:8080
PUBLIC_URL=http://localhost:8080
HTTP_READ_HEADER_TIMEOUT=5s
HTTP_READ_TIMEOUT=30s
HTTP_IDLE_TIMEOUT=2m
HTTP_MAX_HEADER_BYTES=1048576
HTTP_SHUTDOWN_TIMEOUT=15s
DATABASE_URL=postgres://basis:basis@postgres:5432/basis_social?sslmode=disable
REDIS_URL=redis://redis:6379/0
JWT_SECRET=change-me-in-production
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=720h
REGISTRATION_ENABLED=true
FEDERATION_MODE=disabled
MAX_REQUEST_BODY_BYTES=8388608
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS=600
RATE_LIMIT_WINDOW=1m
CORS_ALLOWED_ORIGINS=
METRICS_ENABLED=true
JSON_LOGS_ENABLED=true
READINESS_TIMEOUT=2s
OTEL_TRACING_ENABLED=false
OTEL_SERVICE_NAME=basisvr-social-api
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_TRACES_SAMPLER_RATIO=0.1
REALTIME_BUFFER_SIZE=128
REALTIME_BUS_BUFFER_SIZE=1024
REALTIME_REDIS_CHANNEL=basisvr:realtime:v1
REALTIME_REDIS_PUBLISH_TIMEOUT=2s
REALTIME_REPLAY_ENABLED=true
REALTIME_REPLAY_RETENTION=24h
REALTIME_REPLAY_MAX_ENTRIES=10000
REALTIME_REPLAY_LIMIT=500
REALTIME_REPLAY_PREFIX=basisvr:realtime
REALTIME_REPLAY_STORE_TIMEOUT=250ms
PRESENCE_SWEEP_INTERVAL=15s
PRESENCE_SWEEP_BATCH_SIZE=500
ACTIVITYPUB_ENABLED=false
ACTIVITYPUB_DOMAIN=localhost
ACTIVITYPUB_AUTHORIZED_FETCH=protected
ACTIVITYPUB_DELIVERY_CONCURRENCY=16
ACTIVITYPUB_MAX_DELIVERY_ATTEMPTS=6
ACTIVITYPUB_FETCH_TIMEOUT=10s
ACTIVITYPUB_MAX_REMOTE_RESPONSE_BYTES=5242880
RETENTION_INTERVAL=1h
RETENTION_BATCH_SIZE=1000
RETENTION_INBOX_AGE=720h
RETENTION_OUTBOX_AGE=720h
RETENTION_NOTIFICATIONS_AGE=4320h
RETENTION_INVITES_AGE=2160h
RETENTION_INBOUND_ACTIVITY_AGE=4320h
ASSET_CATALOG_ENABLED=false
ASSET_CATALOG_CODE=beeba
ASSET_CATALOG_NAME=BeeBa Asset Catalog
ASSET_CATALOG_KIND=beeba
ASSET_CATALOG_BASE_URL=
ASSET_CATALOG_API_BASE_URL=
ASSET_CATALOG_API_TOKEN=
ASSET_CATALOG_TIMEOUT=5s

# Forwarding headers are ignored unless the immediate TCP peer is inside one of these CIDRs.
# Set only the actual private reverse proxy network; never use 0.0.0.0/0 or ::/0.
TRUSTED_PROXY_CIDRS=
# Per-process, per-IP authentication endpoint limit per minute (in addition to global limit).
AUTH_RATE_LIMIT_REQUESTS=20
# Bound each in-memory rate map; unknown clients are denied when full until expiry.
RATE_LIMIT_MAX_KEYS=10000

# Required in every environment. Generate once with openssl rand -base64 32 and store securely.
# The same persistent key is used by API and delivery. Never use the JWT or integration secret.
ACTOR_KEY_ENCRYPTION_KEY=
# Prefer secret files in deployment; set this instead of the direct variable.
# ACTOR_KEY_ENCRYPTION_KEY_FILE=/run/secrets/actor_key_encryption_key

# Optional BeeBa identity authority. Configure a separate shared service secret.
BEEBA_IDENTITY_ENABLED=false
BEEBA_IDENTITY_API_URL=
BEEBA_IDENTITY_PUBLIC_URL=
BEEBA_IDENTITY_SECRET=
# Alternatively set BEEBA_IDENTITY_SECRET_FILE to a mounted secret file.
BEEBA_IDENTITY_TIMEOUT=3s
